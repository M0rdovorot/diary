# Скопируйте в .env и заполните
TELEGRAM_BOT_TOKEN=

# Telegram user ID владельца — бот отвечает только ему (узнать: @userinfobot)
ALLOWED_USER_ID=

# Postgres. Пароль — любой без спецсимволов (напр. `openssl rand -hex 16`).
# DATABASE_URL — для запуска бота локально (make run); в docker compose адрес подставляется сам.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://diary:ВАШ_ПАРОЛЬ@localhost:5432/diary?sslmode=disable

# Пароль шифрования бэкапов (`openssl rand -hex 24`). Храните его ОТДЕЛЬНО от сервера,
# например в менеджере паролей: без него бэкапы не расшифровать.
BACKUP_PASSPHRASE=

# Локальные .ogg удаляются сразу после успешного распознавания; файлы после неудачной
# обработки подметаются через столько дней (проверка при старте и раз в сутки).
DATA_RETENTION_DAYS=7

# День дневника: часовой пояс и час границы (голосовое до этого часа относится к предыдущему дню)
DIARY_TZ=Europe/Moscow
DAY_CUTOFF_HOUR=5

# Yandex Cloud
# API-ключ сервисного аккаунта (SpeechKit + YandexGPT), заголовок "Authorization: Api-Key ..."
YC_API_KEY=
# ID каталога (нужен для modelUri YandexGPT: gpt://<folder_id>/yandexgpt/latest)
YC_FOLDER_ID=
# Модель саммаризации: yandexgpt/latest — Pro (по умолчанию), yandexgpt-lite/latest — Lite
YC_GPT_MODEL=yandexgpt/latest

# Object Storage: приватный бакет, куда бот кладёт OGG для асинхронного SpeechKit
YC_BUCKET=
# Статический ключ доступа сервисного аккаунта (НЕ тот же, что API-ключ)
YC_S3_ACCESS_KEY_ID=
YC_S3_SECRET_ACCESS_KEY=
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1

# Прокси. Go берёт HTTP(S)_PROXY из окружения; если в нём локальный прокси,
# запросы к *.api.cloud.yandex.net зависают — исключаем их через NO_PROXY.
# Значения из .env подхватываются и make run, и docker compose.
# Оставьте пустым, если прокси нет.
NO_PROXY=.api.cloud.yandex.net
# Прокси для Telegram, если напрямую он недоступен (бот в compose работает в сети хоста,
# поэтому локальный прокси хоста ему виден).
# HTTPS_PROXY=http://127.0.0.1:2080
# HTTP_PROXY=http://127.0.0.1:2080

# Mini App — календарь дней (/calendar и кнопка меню). Публичный HTTPS-адрес, по которому
# Telegram открывает страницу (например https://<IP-с-дефисами>.sslip.io). Пусто — календарь выключен.
WEBAPP_URL=
# Домен для Caddy (make web-up) — тот же, что в WEBAPP_URL, без https://.
WEBAPP_DOMAIN=
# Где слушает HTTP-сервер Mini App. Caddy ходит к нему на 127.0.0.1:8080, поэтому на сервере —
# только localhost, чтобы порт не был виден снаружи.
WEBAPP_ADDR=127.0.0.1:8080
